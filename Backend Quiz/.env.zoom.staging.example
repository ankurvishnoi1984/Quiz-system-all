# Copy into demo API Backend Quiz/.env (never commit secrets).

ZOOM_APP_ENABLED=true
ZOOM_CLIENT_ID=REPLACE_WITH_ZOOM_CLIENT_ID
ZOOM_CLIENT_SECRET=REPLACE_WITH_ZOOM_CLIENT_SECRET
ZOOM_REDIRECT_URI=https://demoquizapi.netcastservice.online/api/v1/integrations/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET=REPLACE_WITH_ZOOM_SECRET_TOKEN

# Scopes requested on Connect Zoom (must also be enabled on the Marketplace app).
# Default in code is user:read:user if this is unset.
ZOOM_OAUTH_SCOPES=user:read:user

# Must be the SPA origin — NOT the API host — or oauth=connected lands on API JSON "Route not found".
FRONTEND_PUBLIC_URL=https://highq.netcastservice.online

# Marketplace (same Zoom app / Client ID as above) — set in Zoom App credentials UI, not .env:
#   Home URL          = https://highq.netcastservice.online/zoom/app
#   OAuth Redirect    = https://demoquizapi.netcastservice.online/api/v1/integrations/zoom/oauth/callback
# After deploy: GET …/integrations/zoom/status → frontend_public_url should be highq and frontend_public_url_ok=true
# Then Connect Zoom again; address bar should be highq /zoom/app?oauth=connected
# Note: oauth callback uses an HTML handoff (not HTTP 302 Location) because IIS ARR rewrites
# absolute Location hosts back to demoquizapi and would recreate JSON "Route not found".
