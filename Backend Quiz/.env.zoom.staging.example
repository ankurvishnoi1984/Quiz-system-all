# Copy into demo API Backend Quiz/.env (never commit secrets).

ZOOM_APP_ENABLED=true
ZOOM_CLIENT_ID=REPLACE_WITH_ZOOM_CLIENT_ID
ZOOM_CLIENT_SECRET=REPLACE_WITH_ZOOM_CLIENT_SECRET
ZOOM_REDIRECT_URI=https://demoquizapi.netcastservice.online/api/v1/integrations/zoom/oauth/callback
ZOOM_WEBHOOK_SECRET=REPLACE_WITH_ZOOM_SECRET_TOKEN

# Scopes requested on Connect Zoom (must also be enabled on the Marketplace app).
# Default in code is user:read:user if this is unset.
ZOOM_OAUTH_SCOPES=user:read:user

# Must be the SPA origin — NOT the API host — or oauth=error lands on API JSON "Route not found".
FRONTEND_PUBLIC_URL=https://highq.netcastservice.online
