# Copy these into Backend Quiz/.env (never commit real secrets).
# MongoDB stays on the Windows server at 127.0.0.1 — do not open 27017 publicly.

MONGO_LOG_ENABLED=true
MONGO_URI=mongodb://quiz_logs_app:UseAStrongPasswordHere@127.0.0.1:27017/quiz_logs?authSource=quiz_logs
# MONGO_LOG_RETENTION_DAYS=90

# Off when the Node API runs on the same Windows server as MongoDB.
# On when the API runs elsewhere (e.g. Linux Mint) and needs an SSH tunnel.
MONGO_SSH_TUNNEL_ENABLED=true
MONGO_SSH_HOST=43.254.29.10
MONGO_SSH_PORT=2222
MONGO_SSH_USER=rbdcadmin

# Prefer a private key over password. Leave empty if unused.
# Password = Windows login password for MONGO_SSH_USER (same as Compass SSH / terminal ssh).
# Private key = path to YOUR key file on this machine (only after you create one and install the public key on the server).
#
# IMPORTANT: if the password contains # $ " ' \ or spaces, wrap it in double quotes:
#   MONGO_SSH_PASSWORD="my#pass$word"
# Unquoted # starts a comment in .env and truncates the value.
MONGO_SSH_PRIVATE_KEY_PATH=
MONGO_SSH_PASSWORD=$#@s#4887FF

MONGO_SSH_LOCAL_HOST=127.0.0.1
MONGO_SSH_LOCAL_PORT=27017
MONGO_SSH_REMOTE_HOST=127.0.0.1
MONGO_SSH_REMOTE_PORT=27017
