VITE_API_BASE_URL=https://demoquizapi.netcastservice.online/api/v1
VITE_WS_BASE_URL=wss://demoquizapi.netcastservice.online/ws
VITE_WS_DEBUG=true
# Participant join links (QR + copy). Use your deployed frontend origin (no trailing slash).
VITE_PUBLIC_APP_URL=https://demoquiz.netcastservice.online/
VITE_WEBSITE_URL=https://highq.netcastservice.online
# Zoom Apps: keep routes on; do not invent a fake meeting when opened outside Zoom.
# Explicit Share “Local mock” links (?mockMeetingUuid=…) still work.
VITE_ZOOM_APP_ENABLED=true
VITE_ZOOM_MOCK_CONTEXT=false